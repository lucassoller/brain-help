<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B9E5FF"
            android:fillViewport="true"
            tools:context=".activity.TelaLoginActivity">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="65dp"
            android:paddingEnd="30dp"
            android:paddingBottom="30dp">

        <Button
                android:id="@+id/bt_google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/button_corner_white"
                android:drawableStart="@drawable/search32"
                android:drawableLeft="@drawable/search32"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Entrar com o Gmail"
                android:textAllCaps="false" />

        <LinearLayout
                android:id="@+id/layout_divisor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:layout_marginBottom="35dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#66000000" />

            <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="ou" />

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#66000000" />
        </LinearLayout>

        <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="18sp" />

        <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:textColorHint="#38B6FF" />

        <TextView
                android:id="@+id/tv_senha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Senha"
                android:textSize="18sp" />

        <EditText
                android:id="@+id/et_senha"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:background="#FFFFFF"
                android:hint="Senha"
                android:inputType="textPassword"
                android:padding="10dp"
                android:textColorHint="#38B6FF" />

        <TextView
                android:id="@+id/tv_esqueceu_senha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/forget_password" />

        <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:minHeight="32dp"
                android:layout_weight="1" />

        <Button
                android:id="@+id/bt_entrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/button_corner_purple"
                android:text="Entrar"
                android:textColor="#FFFFFF" />

        <TextView
                android:id="@+id/tv_cadastrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/no_account" />

    </LinearLayout>
</ScrollView>